{
 "Resources": {
  "AgentCoreGatewayRoleB10592CC": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": "sts:AssumeRole",
       "Effect": "Allow",
       "Principal": {
        "Service": "bedrock.amazonaws.com"
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "Policies": [
     {
      "PolicyDocument": {
       "Statement": [
        {
         "Action": [
          "bedrock:InvokeModel",
          "secretsmanager:GetSecretValue"
         ],
         "Effect": "Allow",
         "Resource": "*"
        }
       ],
       "Version": "2012-10-17"
      },
      "PolicyName": "GatewayPolicy"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "AgentCoreStack/AgentCoreGatewayRole/Resource"
   }
  },
  "AgentCoreGateway": {
   "Type": "AWS::BedrockAgentCore::Gateway",
   "Properties": {
    "AuthorizerType": "CUSTOM_JWT",
    "Description": "AgentCore Gateway for Databricks MCP server integration",
    "Name": "agentcore-mcp-gateway",
    "ProtocolType": "MCP",
    "RoleArn": {
     "Fn::GetAtt": [
      "AgentCoreGatewayRoleB10592CC",
      "Arn"
     ]
    }
   },
   "Metadata": {
    "aws:cdk:path": "AgentCoreStack/AgentCoreGateway"
   }
  },
  "DatabricksMcpTarget": {
   "Type": "AWS::BedrockAgentCore::GatewayTarget",
   "Properties": {
    "CredentialProviderConfigurations": [
     {
      "CredentialProvider": {
       "OauthCredentialProvider": {
        "GrantType": "CLIENT_CREDENTIALS",
        "ProviderArn": "arn:aws:secretsmanager:us-east-1:PLACEHOLDER_ACCOUNT_ID:secret:databricks-oauth",
        "Scopes": [
         "all-apis"
        ]
       }
      },
      "CredentialProviderType": "OAUTH"
     }
    ],
    "Description": "Databricks-hosted MCP server for legacy data extraction and custom tool integrations",
    "GatewayIdentifier": {
     "Fn::GetAtt": [
      "AgentCoreGateway",
      "GatewayIdentifier"
     ]
    },
    "Name": "databricks-mcp-server",
    "TargetConfiguration": {
     "Mcp": {
      "McpServer": {
       "Endpoint": "https://PLACEHOLDER.databricks.com"
      }
     }
    }
   },
   "Metadata": {
    "aws:cdk:path": "AgentCoreStack/DatabricksMcpTarget"
   }
  },
  "CDKMetadata": {
   "Type": "AWS::CDK::Metadata",
   "Properties": {
    "Analytics": "v2:deflate64:H4sIAAAAAAAA/0WNsQ7CIBRFv8WdPitd3B0cTaq7eYVnQ2mhgYeNIfy7NA5O5+ac4UqQ3RnaA26xUdo2sxkg3xmVFVU9s8EFcu9nEpeX21nEQDp4ZXEkx8oHglzTFZk2/Ij/fGAYiUvZ1S3xmrgI5zXBFI9v2cGprbdTNKYJybFZCPofv3pJ2UGTAAAA"
   },
   "Metadata": {
    "aws:cdk:path": "AgentCoreStack/CDKMetadata/Default"
   }
  }
 },
 "Outputs": {
  "GatewayId": {
   "Value": {
    "Fn::GetAtt": [
     "AgentCoreGateway",
     "GatewayIdentifier"
    ]
   },
   "Export": {
    "Name": "AgentCoreGatewayId"
   }
  },
  "GatewayTargetId": {
   "Value": {
    "Fn::GetAtt": [
     "DatabricksMcpTarget",
     "TargetId"
    ]
   },
   "Export": {
    "Name": "AgentCoreGatewayTargetId"
   }
  }
 },
 "Parameters": {
  "BootstrapVersion": {
   "Type": "AWS::SSM::Parameter::Value<String>",
   "Default": "/cdk-bootstrap/hnb659fds/version",
   "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
  }
 },
 "Rules": {
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 }
}